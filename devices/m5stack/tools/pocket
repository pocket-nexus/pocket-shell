#!/bin/sh
# Pocket Shell's CLI (cli/pocket-shell.ts at the repository root). CMake
# helpers in PocketJS's pocket_runtime component invoke this script through
# POCKETJS_CLI: `compile` runs in that CLI, and `host export` is forwarded by
# it to the pinned vendor/pocketjs checkout.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec bun "$root/../../cli/pocket-shell.ts" "$@"
