{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun",
      "opentype.js"
    ],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@pocketjs/framework": [
        "./../../vendor/pocketjs/framework/src/index.ts"
      ],
      "@pocketjs/framework/clock": [
        "./../../vendor/pocketjs/framework/src/clock.ts"
      ],
      "@pocketjs/framework/components": [
        "./../../vendor/pocketjs/framework/src/components.ts"
      ],
      "@pocketjs/framework/host": [
        "./../../vendor/pocketjs/framework/src/host.ts"
      ],
      "@pocketjs/framework/lifecycle": [
        "./../../vendor/pocketjs/framework/src/lifecycle.ts"
      ],
      "@pocketjs/framework/manifest": [
        "./../../vendor/pocketjs/framework/src/manifest/index.ts"
      ]
    },
    "jsxImportSource": "solid-js"
  },
  "include": [
    "src",
    "scripts",
    "test"
  ]
}
