{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.desktop.system-ui",
  "name": "pocket-desktop-system-ui",
  "title": "Pocket Shell Desktop",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "ui.compositor-surfaces",
        "io.offload",
        "text.layout.offload"
      ],
      "enhances": [
        "input.text",
        "input.pointer",
        "input.ime",
        "host.clipboard",
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "src/system-ui/main.tsx",
    "output": "pocket-desktop-system-ui",
    "framework": "solid",
    "companions": [
      "system-ui"
    ],
    "viewport": {
      "dynamic": {
        "default": [
          800,
          600
        ],
        "min": [
          640,
          480
        ]
      }
    }
  }
}
