{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.photos",
  "name": "pocket-photos",
  "title": "Photos",
  "version": "0.1.0",
  "applet": {
    "version": 1,
    "summary": "The pictures on the 3DS's SD card."
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "camera.photo"
      ],
      "enhances": [
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "photos/main.tsx",
    "output": "photos-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "fixed": {
          "logical": [
            320,
            240
          ],
          "presentation": "native"
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          400,
          240
        ],
        "presentation": "native"
      }
    }
  }
}
