{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.hn",
  "name": "pocket-hn",
  "title": "Hacker News",
  "version": "0.1.0",
  "applet": {
    "version": 1,
    "hosts": [
      "hacker-news.firebaseio.com"
    ]
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "net.http"
      ],
      "enhances": [
        "input.analog.left",
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "hn/main.tsx",
    "output": "hn-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [320, 240],
          "max": [640, 720]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [400, 240],
        "presentation": "native"
      }
    }
  }
}
