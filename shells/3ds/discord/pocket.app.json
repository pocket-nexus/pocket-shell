{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.discord",
  "title": "Discord",
  "version": "0.1.0",
  "applet": {
    "version": 1,
    "services": [
      "discord",
      "glyphs"
    ]
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "net.http"
      ],
      "enhances": [
        "input.analog.left",
        "system.agent",
        "display.auxiliary",
        "input.touch.auxiliary"
      ]
    }
  },
  "app": {
    "entry": "discord/main.tsx",
    "output": "discord-main",
    "framework": "solid",
    "modality": {
      "touch": "auxiliary"
    },
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [320, 240],
          "max": [640, 720]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [400, 240],
        "presentation": "native"
      }
    },
    "presentations": [
      {
        "id": "full-screen",
        "entry": "discord/main.tsx",
        "modality": {
          "screens": 1,
          "touch": "none",
          "buttons": true
        },
        "viewport": {
          "fixed": {
            "logical": [480, 272],
            "presentation": "native"
          }
        }
      }
    ]
  },
  "domains": {
    "worker": {
      "entry": "ui/net-worker.ts",
      "nodes": [{ "name": "http", "kind": "http" }],
      "channels": [
        { "name": "request", "kind": "ring", "direction": "ui-to-worker", "recordBytes": 1024, "capacity": 4 },
        { "name": "response", "kind": "ring", "direction": "worker-to-ui", "recordBytes": 1024, "capacity": 8 }
      ]
    }
  }
}
