{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.podcasts",
  "title": "Podcasts",
  "version": "0.1.2",
  "applet": {
    "version": 1,
    "services": [
      "podcasts",
      "store"
    ]
  },
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary",
        "net.http"
      ],
      "enhances": [
        "input.analog.left",
        "media.playback",
        "system.agent"
      ]
    }
  },
  "app": {
    "entry": "podcasts/main.tsx",
    "output": "podcasts-main",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "adaptive": {
          "min": [
            320,
            240
          ],
          "max": [
            640,
            720
          ]
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          400,
          240
        ],
        "presentation": "native"
      }
    }
  },
  "domains": {
    "worker": {
      "entry": "ui/net-worker.ts",
      "nodes": [{ "name": "http", "kind": "http" }],
      "channels": [
        { "name": "request", "kind": "ring", "direction": "ui-to-worker", "recordBytes": 1024, "capacity": 4 },
        { "name": "response", "kind": "ring", "direction": "worker-to-ui", "recordBytes": 1024, "capacity": 8 }
      ]
    }
  }
}
