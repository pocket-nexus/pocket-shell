{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.shell",
  "name": "pocket-shell",
  "title": "Pocket Shell",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.auxiliary",
        "input.touch.auxiliary"
      ],
      "enhances": [
        "link.companion",
        "system.wifi",
        "camera.qr",
        "input.analog.left",
        "media.playback",
        "system.agent",
        "data.fs"
      ]
    }
  },
  "app": {
    "entry": "shell/main.tsx",
    "output": "pocket-shell",
    "framework": "solid",
    "surfaces": {
      "auxiliary": {
        "fixed": {
          "logical": [
            320,
            240
          ],
          "presentation": "native"
        }
      }
    },
    "viewport": {
      "fixed": {
        "logical": [
          400,
          240
        ],
        "presentation": "native"
      }
    }
  }
}
